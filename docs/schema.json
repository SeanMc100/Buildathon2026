{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Buildathon App data contracts",
  "description": "Source of truth for data shapes shared across slices. Changes must be announced to the team. Mirror in src/models.",
  "definitions": {
    "AnswerMap": {
      "type": "object",
      "description": "questionId -> answer. single:string, multi/rank:string[], scale:number(1..n), allocate:{optionValue:points}, text:string.",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "array", "items": { "type": "string" } },
          { "type": "object", "additionalProperties": { "type": "number" } }
        ]
      }
    },
    "Inference": {
      "type": "object",
      "description": "Any value the app derived rather than was told. Never emit one without provenance.",
      "required": ["value", "confidence", "sourceQuestionIds"],
      "properties": {
        "value": {},
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceQuestionIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "HardConstraints": {
      "type": "object",
      "description": "Must-satisfy filters. Applied before anything is ranked.",
      "required": ["arrangements", "employmentTypes", "payStance", "exclusions"],
      "properties": {
        "arrangements": {
          "type": "array",
          "items": { "enum": ["Remote", "Hybrid", "Onsite"] }
        },
        "employmentTypes": {
          "type": "array",
          "items": {
            "enum": ["FullTime", "PartTime", "Contract", "Freelance", "Internship", "Apprenticeship"]
          }
        },
        "maxCommuteMinutes": { "type": ["number", "null"] },
        "openToRelocation": { "type": "boolean" },
        "payStance": { "enum": ["flexible", "market", "top_of_market", "has_floor"] },
        "minSalaryUsd": { "type": ["number", "null"] },
        "exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PreferenceWeight": {
      "type": "object",
      "description": "Soft preference. Weights across the list sum to ~100.",
      "required": ["trait", "label", "weight", "confidence", "sourceQuestionIds"],
      "properties": {
        "trait": {
          "enum": [
            "pay_and_security",
            "flexibility_and_balance",
            "growth_and_learning",
            "mission_and_impact",
            "people_and_team",
            "manager_support",
            "autonomy"
          ]
        },
        "label": { "type": "string" },
        "weight": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceQuestionIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "CareerProfile": {
      "type": "object",
      "description": "Output of src/matching/scoring.ts. Shown to the user and folded into MatchRequest.",
      "required": [
        "profileId",
        "generatedAt",
        "version",
        "narrativeSummary",
        "stage",
        "experienceBand",
        "educationLevel",
        "jobZone",
        "interests",
        "workStyle",
        "priorities",
        "workValues",
        "hardConstraints",
        "completeness"
      ],
      "properties": {
        "profileId": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "version": { "type": "number" },
        "narrativeSummary": { "type": "string" },
        "stage": { "$ref": "#/definitions/Inference" },
        "experienceBand": { "enum": ["none", "under_1", "1_3", "3_6", "6_10", "10_plus"] },
        "educationLevel": {
          "enum": ["none_required", "secondary", "certificate", "associate", "bachelor", "postgraduate"]
        },
        "jobZone": { "$ref": "#/definitions/Inference" },
        "focusArea": { "type": ["string", "null"] },
        "interests": {
          "type": "object",
          "properties": {
            "scores": { "type": "object", "additionalProperties": { "type": "number" } },
            "hollandCode": { "type": "array", "items": { "enum": ["R", "I", "A", "S", "E", "C"] } },
            "confidence": { "type": "number" },
            "sourceQuestionIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "workStyle": {
          "type": "object",
          "properties": {
            "autonomy": { "$ref": "#/definitions/Inference" },
            "variety": { "$ref": "#/definitions/Inference" },
            "pace": { "$ref": "#/definitions/Inference" },
            "challengeAppetite": { "$ref": "#/definitions/Inference" },
            "teamShape": { "$ref": "#/definitions/Inference" }
          }
        },
        "priorities": { "type": "array", "items": { "$ref": "#/definitions/PreferenceWeight" } },
        "workValues": { "$ref": "#/definitions/Inference" },
        "hardConstraints": { "$ref": "#/definitions/HardConstraints" },
        "extraContext": { "type": ["string", "null"] },
        "skippedQuestionIds": { "type": "array", "items": { "type": "string" } },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "MatchRequest": {
      "type": "object",
      "description": "POST body for expo.extra.matchingEndpoint. Built by src/matching/payload.ts.",
      "required": [
        "schemaVersion",
        "profileId",
        "narrativeSummary",
        "candidateContext",
        "hardConstraints",
        "softPreferences",
        "responseContract",
        "excludedAttributes"
      ],
      "properties": {
        "schemaVersion": { "type": "string" },
        "profileId": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "narrativeSummary": { "type": "string" },
        "candidateContext": { "type": "object" },
        "hardConstraints": { "$ref": "#/definitions/HardConstraints" },
        "softPreferences": { "type": "array" },
        "workStyle": { "type": "array" },
        "interests": { "type": "object" },
        "derivedWorkValues": { "type": "object" },
        "freeText": { "type": ["string", "null"] },
        "responseContract": {
          "type": "object",
          "properties": {
            "max_recommendations": { "type": "number" },
            "must_cite_source_question_ids": { "type": "boolean" },
            "must_explain_tradeoffs": { "type": "boolean" },
            "must_flag_unmet_hard_constraints": { "type": "boolean" }
          }
        },
        "excludedAttributes": {
          "type": "array",
          "description": "Protected or restricted attributes deliberately absent. The model is told not to infer them.",
          "items": { "type": "string" }
        }
      }
    },
    "MatchResponse": {
      "type": "object",
      "description": "Expected response from the matching endpoint.",
      "required": ["recommendations"],
      "properties": {
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "summary", "matchScore", "whyItFits", "citedQuestionIds"],
            "properties": {
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "matchScore": { "type": "number", "minimum": 0, "maximum": 100 },
              "whyItFits": { "type": "array", "items": { "type": "string" } },
              "gaps": { "type": "array", "items": { "type": "string" } },
              "citedQuestionIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "unmetConstraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "OpportunityBase": {
      "type": "object",
      "description": "Fields shared by every kind of opportunity. Tags use the same vocabulary as CareerProfile so one scorer can compare them.",
      "required": [
        "id", "kind", "title", "organization", "summary", "url", "location", "arrangement",
        "hollandCode", "traits", "jobZone", "minEducation", "suitableStages", "demands",
        "verifiedOn", "isSample"
      ],
      "properties": {
        "id": { "type": "string", "description": "Stable slug, unique across the catalog." },
        "kind": { "enum": ["job", "program", "event", "research"] },
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "summary": { "type": "string" },
        "url": { "type": "string" },
        "location": { "type": ["string", "null"] },
        "arrangement": { "enum": ["Remote", "Hybrid", "Onsite"] },
        "hollandCode": {
          "type": "array",
          "description": "Top one to three RIASEC codes, ranked.",
          "minItems": 1,
          "maxItems": 3,
          "items": { "enum": ["R", "I", "A", "S", "E", "C"] }
        },
        "traits": {
          "type": "object",
          "description": "0-100 per PreferenceWeight.trait: how strongly the opportunity delivers it. Not a sum-to-100.",
          "required": [
            "pay_and_security", "flexibility_and_balance", "growth_and_learning",
            "mission_and_impact", "people_and_team", "manager_support", "autonomy"
          ],
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "jobZone": {
          "enum": [1, 2, 3, 4, 5, null],
          "description": "Preparation level assumed. Null = open to any level, skip level distance."
        },
        "minEducation": {
          "enum": ["none_required", "secondary", "certificate", "associate", "bachelor", "postgraduate"]
        },
        "suitableStages": {
          "type": "array",
          "description": "CareerProfile.stage values it is aimed at. Empty = all.",
          "items": { "enum": ["FirstRole", "EarlyCareer", "MidCareer", "Pivot", "Returner", "SteppingUp"] }
        },
        "demands": {
          "type": "array",
          "description": "Checked against HardConstraints.exclusions. Same keys as the dealbreakers question.",
          "items": {
            "enum": [
              "night_shifts", "heavy_travel", "on_call", "sales_targets",
              "managing_people", "physical_work", "high_stakes"
            ]
          }
        },
        "verifiedOn": { "type": "string", "format": "date", "description": "Last date someone confirmed the listing is real and current." },
        "isSample": { "type": "boolean", "description": "True for placeholders. The UI must label these as samples." }
      }
    },
    "Opportunity": {
      "description": "A job or internship, program, event or research program. Discriminated on `kind`. Visibility rules: an event is hidden once its endsAt (or startsAt when endsAt is null) has passed; any opportunity whose applyBy has passed is also hidden. Rule is applied by the matching slice before ranking.",
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/definitions/OpportunityBase" },
            {
              "type": "object",
              "required": ["kind", "employmentType", "payMinUsd", "payMaxUsd", "applyBy"],
              "properties": {
                "kind": { "const": "job" },
                "employmentType": {
                  "enum": ["FullTime", "PartTime", "Contract", "Freelance", "Internship", "Apprenticeship"]
                },
                "payMinUsd": { "type": ["number", "null"] },
                "payMaxUsd": { "type": ["number", "null"] },
                "applyBy": { "type": ["string", "null"], "format": "date", "description": "Null = rolling or unknown." }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/OpportunityBase" },
            {
              "type": "object",
              "required": ["kind", "costUsd", "stipendUsd", "durationWeeks", "startsAt", "applyBy", "eligibility"],
              "properties": {
                "kind": { "const": "program" },
                "costUsd": { "type": ["number", "null"], "description": "0 = free." },
                "stipendUsd": { "type": ["number", "null"] },
                "durationWeeks": { "type": ["number", "null"] },
                "startsAt": { "type": ["string", "null"], "format": "date" },
                "applyBy": { "type": ["string", "null"], "format": "date" },
                "eligibility": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/OpportunityBase" },
            {
              "type": "object",
              "required": ["kind", "format", "startsAt", "endsAt", "costUsd"],
              "properties": {
                "kind": { "const": "event" },
                "format": { "enum": ["workshop", "networking", "talk", "career_fair", "conference"] },
                "startsAt": { "type": "string", "format": "date-time" },
                "endsAt": { "type": ["string", "null"], "format": "date-time" },
                "costUsd": { "type": ["number", "null"] }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/OpportunityBase" },
            {
              "type": "object",
              "required": ["kind", "field", "stipendUsd", "durationWeeks", "startsAt", "applyBy", "eligibility"],
              "properties": {
                "kind": { "const": "research" },
                "field": { "type": "string" },
                "stipendUsd": { "type": ["number", "null"] },
                "durationWeeks": { "type": ["number", "null"] },
                "startsAt": { "type": ["string", "null"], "format": "date" },
                "applyBy": { "type": ["string", "null"], "format": "date" },
                "eligibility": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        }
      ]
    },
    "OpportunityMatch": {
      "type": "object",
      "description": "One scored result from the matching slice. References the catalog by id.",
      "required": ["opportunityId", "kind", "matchScore", "whyItFits", "gaps", "citedQuestionIds"],
      "properties": {
        "opportunityId": { "type": "string" },
        "kind": { "enum": ["job", "program", "event", "research"] },
        "matchScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "whyItFits": { "type": "array", "items": { "type": "string" } },
        "gaps": { "type": "array", "items": { "type": "string" } },
        "citedQuestionIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "OpportunityResults": {
      "type": "object",
      "description": "Everything the results screen renders.",
      "required": ["profileId", "generatedAt", "byKind", "unmetConstraints"],
      "properties": {
        "profileId": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "byKind": {
          "type": "object",
          "description": "Best matches first within each kind.",
          "required": ["job", "program", "event", "research"],
          "additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/OpportunityMatch" } }
        },
        "unmetConstraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Board": {
      "type": "object",
      "description": "A Metro Detroit bulletin board. Age boards are one-of per member, job boards many-of. Membership is self-declared, not verified.",
      "required": ["id", "category", "name", "blurb"],
      "properties": {
        "id": { "type": "string" },
        "category": { "enum": ["age", "job"] },
        "name": { "type": "string" },
        "blurb": { "type": "string" },
        "ageBand": { "type": "string", "description": "Age boards only. The age_band questionnaire answer it lines up with; read locally, never sent." }
      }
    },
    "BoardMessage": {
      "type": "object",
      "description": "One chat message on a board.",
      "required": ["id", "boardId", "authorId", "authorHandle", "postedAt", "isSample", "body"],
      "properties": {
        "id": { "type": "string" },
        "boardId": { "type": "string" },
        "authorId": { "type": "string", "description": "Stable per-install id. Not a real identity." },
        "authorHandle": { "type": "string", "description": "Anonymous display name, e.g. 'Member 4821'." },
        "postedAt": { "type": "string", "format": "date-time" },
        "isSample": { "type": "boolean", "description": "True for placeholders. The UI must label these." },
        "body": { "type": "string", "maxLength": 500 }
      }
    },
    "BoardPost": {
      "type": "object",
      "description": "A member-shared opportunity that is not in the catalog.",
      "required": ["id", "boardId", "authorId", "authorHandle", "postedAt", "isSample", "kind", "title", "organization", "city", "url", "details"],
      "properties": {
        "id": { "type": "string" },
        "boardId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorHandle": { "type": "string" },
        "postedAt": { "type": "string", "format": "date-time" },
        "isSample": { "type": "boolean" },
        "kind": { "enum": ["job", "research", "program", "event", "other"] },
        "title": { "type": "string", "maxLength": 80 },
        "organization": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "description": "A Metro Detroit city, or 'Remote'." },
        "url": { "type": ["string", "null"], "description": "http(s) only." },
        "details": { "type": "string", "maxLength": 600 }
      }
    }
  }
}
